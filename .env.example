ADMIN_PASSWORD=change-this-password
SECRET_KEY=change-this-random-secret
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o

# Local default when DATABASE_URL is empty: sqlite:///./competitions.db
# Railway PostgreSQL: set this from the PostgreSQL service DATABASE_URL variable.
# DATABASE_URL=sqlite:///./competitions.db

# Local upload folder.
UPLOAD_DIR=uploads

# Railway Volume recommended value when a volume is mounted at /data.
# UPLOAD_DIR=/data/uploads
