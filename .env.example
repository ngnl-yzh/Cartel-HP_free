ADMIN_PASSWORD=change-this-password
SECRET_KEY=change-this-random-secret
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o

# Local default: sqlite:///./competitions.db
# Railway PostgreSQL uses DATABASE_URL automatically when a database plugin is connected.
# DATABASE_URL=sqlite:///./competitions.db

# Railway file storage is ephemeral unless a volume is attached.
UPLOAD_DIR=uploads
